#!/usr/bin/env python3
"""
fuel — Universal logging dispatcher for supplements and meals.

Subcommands:
  fuel meal [args]            Meal logging (log, list, today)
  fuel supplement [args]      Supplement logging (log, list, today)
  fuel today                  Show all logs for today
  fuel list                   List available supplements
  fuel [id] [dose]            Shorthand to log a supplement
"""

import subprocess
import sys
from pathlib import Path

# Resolve to actual fuel-dev directory (handles symlinks)
FUEL_DIR = Path(__file__).resolve().parent

def main():
    if len(sys.argv) < 2:
        # No arguments -> Show combined status for today
        show_combined_today()
        return

    subcommand = sys.argv[1]
    args = sys.argv[2:]

    if subcommand == "meal":
        subprocess.run([str(FUEL_DIR / "fuel-meal")] + args)
    elif subcommand == "supplement":
        subprocess.run([str(FUEL_DIR / "fuel-supplement")] + args)
    elif subcommand == "today":
        show_combined_today()
    elif subcommand == "list":
        # Default list to supplements
        subprocess.run([str(FUEL_DIR / "fuel-supplement"), "list"])
    elif subcommand in ("--help", "-h"):
        print(__doc__)
    else:
        # Assume it's a supplement shorthand (e.g., `fuel melatonin`)
        subprocess.run([str(FUEL_DIR / "fuel-supplement")] + sys.argv[1:])

def show_combined_today():
    """Execute 'today' for both meal and supplement scripts."""
    print("\n--- MEALS ---")
    subprocess.run([str(FUEL_DIR / "fuel-meal"), "today"])
    print("\n--- SUPPLEMENTS ---")
    subprocess.run([str(FUEL_DIR / "fuel-supplement"), "today"])

if __name__ == "__main__":
    main()
