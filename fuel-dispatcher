#!/usr/bin/env python3
"""
fuel — Typer-powered smart logging dispatcher.
"""

import json
import os
import subprocess
import sys
from pathlib import Path
import typer

app = typer.Typer(help="Fuel Centre Smart CLI", no_args_is_help=False)

# Resolve to actual fuel-dev directory
FUEL_DIR = Path(__file__).resolve().parent
CATALOG_PATH = Path(os.environ.get("AOS_FUEL_DIR", Path.home() / ".aos" / "fuel")) / "supplements" / "catalog.json"

def load_supplement_ids():
    """Load supplement IDs from catalog for smart routing."""
    if not CATALOG_PATH.exists():
        return set()
    try:
        data = json.loads(CATALOG_PATH.read_text())
        return {item["id"] for item in data.get("items", [])}
    except:
        return set()

def show_combined_today():
    """Execute 'today' for both meal and supplement scripts."""
    print("\n--- MEALS ---")
    subprocess.run([str(FUEL_DIR / "fuel-meal"), "today"])
    print("\n--- SUPPLEMENTS ---")
    subprocess.run([str(FUEL_DIR / "fuel-supplement"), "today"])

@app.command()
def meal(ctx: typer.Context):
    """Route to fuel-meal."""
    subprocess.run([str(FUEL_DIR / "fuel-meal")] + ctx.args)

@app.command()
def supplement(ctx: typer.Context):
    """Route to fuel-supplement."""
    subprocess.run([str(FUEL_DIR / "fuel-supplement")] + ctx.args)

@app.command()
def today():
    """Show combined status for today."""
    show_combined_today()

@app.command()
def list():
    """List available supplements."""
    subprocess.run([str(FUEL_DIR / "fuel-supplement"), "list"])

@app.callback(invoke_without_command=True)
def main(ctx: typer.Context):
    if ctx.invoked_subcommand is not None:
        return

    # No command given -> check arguments for smart routing
    args = sys.argv[1:]
    if not args:
        show_combined_today()
        return

    subcommand = args[0]
    
    # 1. Smart Routing Logic
    supp_ids = load_supplement_ids()
    
    if subcommand in supp_ids:
        # Route to supplement shorthand
        subprocess.run([str(FUEL_DIR / "fuel-supplement")] + args)
    else:
        # Avoid looping if user typed 'meal' or 'supplement' but Typer didn't catch it as subcommand
        if subcommand not in ("meal", "supplement", "today", "list"):
            # Route to meal log shorthand
            subprocess.run([str(FUEL_DIR / "fuel-meal"), "log"] + args)

if __name__ == "__main__":
    app()
