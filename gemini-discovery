#!/usr/bin/env python3
"""
gemini-discovery — Intelligent classification and catalog generation for unknown items.
Determines if an input is a Supplement or a Meal and provides full metadata.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
import urllib.request

# ── Load .env files ───────────────────────────────────────────────────────────

def _load_env_file(path: Path) -> None:
    if path.exists():
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    key, sep, value = line.partition("=")
                    if sep:
                        os.environ[key.strip()] = value.strip()

_load_env_file(Path.home() / ".env" / "fuel.env")

# ── Config ─────────────────────────────────────────────────────────────────────

GEMINI_API_KEY = os.environ.get("GEMINI_API_KEY", "")
GEMINI_MODEL = os.environ.get("GEMINI_MODEL", "gemini-flash-latest")
GEMINI_API_URL = f"https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent"

# ── Gemini: Discovery ──────────────────────────────────────────────────────────

MICRO_KEYS = [
    "vitamin_a_ug", "vitamin_d_ug", "vitamin_e_mg", "vitamin_k_ug",
    "vitamin_c_mg", "vitamin_b1_mg", "vitamin_b2_mg", "vitamin_b3_mg",
    "vitamin_b5_mg", "vitamin_b6_mg", "vitamin_b7_ug", "folate_ug",
    "vitamin_b12_ug", "calcium_mg", "phosphorus_mg", "magnesium_mg",
    "iron_mg", "zinc_mg", "selenium_ug", "iodine_ug", "potassium_mg",
    "sodium_mg", "omega3_mg"
]

def discover_item(query: str) -> dict:
    if not GEMINI_API_KEY:
        return {"error": "API Key missing"}

    prompt = f"""Analysiere die Eingabe: "{query}"
Handelt es sich um ein Supplement (Pille, Pulver, Kapsel, Vitamin, Mineralstoff) oder eine Mahlzeit/Lebensmittel?

Gib NUR ein JSON-Objekt zurück:
{{
  "type": "supplement" | "meal",
  "catalog_entry": {{
    // Wenn Supplement:
    "id": "eindeutige_id_kleingeschrieben",
    "name": "Anzeigename",
    "unit": "mg" | "g" | "µg" | "ml" | "IU",
    "default_dose": <Zahl>,
    "default_time_of_day": "morning" | "midday" | "evening" | "night" | "any",
    "notes": "Kurze Info"
  }} | {{
    // Wenn Mahlzeit:
    "name": "Name des Gerichts",
    "kcal": <Zahl>,
    "protein": <Zahl>,
    "carbs": <Zahl>,
    "fat": <Zahl>,
    "micros": {{
       "vitamin_a_ug": <Zahl>, ... // alle 23 Mikronährstoffe
    }}
  }}
}}

Liste der Mikro-Keys für Mahlzeiten: {", ".join(MICRO_KEYS)}
"""

    try:
        payload = {"contents": [{"parts": [{"text": prompt}]}]}
        data = json.dumps(payload, ensure_ascii=False).encode('utf-8')
        req = urllib.request.Request(
            GEMINI_API_URL,
            data=data,
            headers={"Content-Type": "application/json", "X-goog-api-key": GEMINI_API_KEY},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=20) as resp:
            result = json.loads(resp.read())

        if "candidates" in result and result["candidates"]:
            text = result["candidates"][0]["content"]["parts"][0]["text"].strip()
            # Extract JSON block
            import re
            json_match = re.search(r'\{.*\}', text, re.DOTALL)
            if json_match:
                return json.loads(json_match.group())
    except Exception as e:
        return {"error": str(e)}

    return {"error": "Discovery failed"}

def main():
    if len(sys.argv) < 2:
        sys.exit(1)

    query = sys.argv[1]
    result = discover_item(query)
    print(json.dumps(result, ensure_ascii=False))

if __name__ == "__main__":
    main()
