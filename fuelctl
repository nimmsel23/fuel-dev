#!/usr/bin/env bash
# fuelctl — Central control for Fuel Centre (Dev, Prod, Sync, Deploy)
set -euo pipefail

# --- Configuration ---
PORT="${PORT:-9000}"
PROD_PORT="${PROD_PORT:-7000}"
VITE_PORT="${VITE_PORT:-5173}"
HEALTH_URL="http://127.0.0.1:${PORT}/health"
PROD_HEALTH_URL="http://127.0.0.1:${PROD_PORT}/health"
WORKDIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
PROD_DIR="/opt/fuel"
BIN_DEVCTL="$WORKDIR/bin/fuel-devctl"
SYNC_SCRIPT="$WORKDIR/scripts/firestore-sync.mjs"

# --- UI Helpers ---
have_gum() { command -v gum >/dev/null 2>&1; }
msg()  { have_gum && gum log --level info  "$*" || printf '\033[1;32m%s\033[0m\n' "$*"; }
warn() { have_gum && gum log --level warn  "$*" >&2 || printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
err()  { have_gum && gum log --level error "$*" >&2 || printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- Commands ---

cmd_status() {
  "$BIN_DEVCTL" status || true
  
  msg "--- Production Server (STABLE) ---"
  if curl -fsS --connect-timeout 1 --max-time 2 "$PROD_HEALTH_URL" >/dev/null 2>&1; then
    msg "● fuel-prod is running on :$PROD_PORT"
  else
    warn "○ fuel-prod is NOT responding on :$PROD_PORT"
  fi

  msg "--- Firestore Sync ---"
  if pgrep -f "firestore-sync.mjs watch" > /dev/null; then
    msg "● Sync Watcher is active"
  else
    warn "○ Sync Watcher is idle"
  fi
}

cmd_dev() {
  local action="${1:-status}"
  case "$action" in
    up|start)
      msg "Starting Fuel Development Stack..."
      "$BIN_DEVCTL" start
      ;;
    down|stop)
      msg "Stopping Fuel Development Stack..."
      "$BIN_DEVCTL" stop
      ;;
    status)
      "$BIN_DEVCTL" status
      ;;
    logs)
      "$BIN_DEVCTL" logs
      ;;
    build)
      local target="${2:-coach}"
      "$BIN_DEVCTL" build "$target"
      ;;
    *) die "Usage: fuelctl dev [up|down|status|logs|build]" ;;
  esac
}

cmd_sync() {
  local action="${1:-menu}"
  case "$action" in
    push) node "$SYNC_SCRIPT" push ;;
    pull) node "$SYNC_SCRIPT" pull ;;
    watch) node "$SYNC_SCRIPT" watch ;;
    menu)
      if have_gum; then
        local choice
        choice=$(gum choose "Push (Local -> Cloud)" "Pull (Cloud -> Local)" "Watch (Auto-Sync)")
        case "$choice" in
          "Push (Local -> Cloud)") node "$SYNC_SCRIPT" push ;;
          "Pull (Cloud -> Local)") node "$SYNC_SCRIPT" pull ;;
          "Watch (Auto-Sync)") node "$SYNC_SCRIPT" watch ;;
        esac
      else
        die "Usage: fuelctl sync [push|pull|watch]"
      fi
      ;;
  esac
}

cmd_deploy() {
  local target="$PROD_DIR"
  
  if have_gum; then
    gum confirm "Möchtest du das stable Backend nach $target deployen?" || die "Abgebrochen."
  else
    printf "Möchtest du das stable Backend nach %s deployen? (y/N) " "$target"
    read -r resp
    [[ "$resp" == "y" || "$resp" == "Y" ]] || die "Abgebrochen."
  fi

  msg "==> Deploying stable prod backend to $target"
  "$BIN_DEVCTL" build coach

  if [[ ! -d "$target" ]]; then
    sudo mkdir -p "$target"
    sudo chown "$(id -u):$(id -g)" "$target"
  fi

  msg "Syncing files..."
  rsync -avz --delete \
    --exclude ".git" \
    --exclude ".env" \
    --exclude "node_modules" \
    --exclude "data" \
    --exclude "dist-client" \
    --exclude ".firebase" \
    --exclude ".archiv" \
    --exclude ".bak" \
    "$WORKDIR/" "$target/"

  msg "Installing production dependencies in $target..."
  (cd "$target" && npm install --production --silent)

  msg "✅ Deployment to $target complete."
}

cmd_help() {
  cat <<EOF
fuelctl — Universal System Control for Fuel Centre

Usage:
  fuelctl status          Check all systems (Dev, Prod, Sync)
  fuelctl dev up          Start development stack (Port 9000)
  fuelctl dev down        Stop development stack
  fuelctl dev logs        Tail development logs
  fuelctl dev build       Manual frontend build (coach, client)
  fuelctl sync [action]   Cloud sync (push, pull, watch)
  fuelctl deploy          Update stable prod backend ($PROD_DIR)
  fuelctl help            Show this message

Dev Stack:    http://127.0.0.1:$PORT
Prod Stack:   http://127.0.0.1:$PROD_PORT
EOF
}

# --- Dispatcher ---
case "${1:-status}" in
  status)         cmd_status ;;
  dev)            cmd_dev "${2:-}" "${3:-}" ;;
  up|start)       cmd_dev up ;;    # Legacy compatibility
  down|stop)      cmd_dev down ;;  # Legacy compatibility
  restart)        cmd_dev down && cmd_dev up ;;
  sync)           cmd_sync "${2:-}" ;;
  deploy)         cmd_deploy ;;
  logs)           cmd_dev logs ;;
  help|--help|-h) cmd_help ;;
  *)              cmd_help; exit 1 ;;
esac
