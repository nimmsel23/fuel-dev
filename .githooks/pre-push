#!/bin/bash
# pre-push hook: build + deploy to Firebase when relevant frontend files are
# part of the push to master (sw cache-busting version wird erst nach dem
# Build in dist-firebase/ gestempelt, scripts/stamp-sw.mjs — public/sw.js
# bleibt dabei unverändert, siehe .githooks/README.md).
#
# Runs once per push (not per ref), reads pushed refs from stdin.

cd "$(git rev-parse --show-toplevel)"

# stdin einmal einlesen — git übergibt die gepushten Refs nur einmal, zwei
# separate `while read`-Schleifen würden sich die Zeilen streitig machen.
pushed_refs="$(cat)"

# Reminder: der volle Release-Flow (fuel-dev dev -> vitalos/fuel-app master ->
# vitalos-Pointer-Bump) läuft bereits automatisiert über
# ~/vitalos/bin/fuel-release (bzw. vos-release fuel). Der kritische Moment ist
# der Push von dev — direkt danach folgt sonst von Hand: Merge in
# vitalos/fuel-app master, Push, Submodule-Pointer in vitalos bumpen. Deshalb
# hier auf "dev" triggern, nicht erst auf "master" (das waere schon der
# vorletzte Schritt der manuellen Kette).
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  if [ "${local_ref#refs/heads/}" = "dev" ]; then
    echo "💡 Tipp: für den kompletten dev->master->vitalos-Flow gibt es ~/vitalos/bin/fuel-release (vos-release fuel --help)." >&2
    break
  fi
done <<< "$pushed_refs"

# dist-firebase/ ist Build-Output — nie selbst ein Deploy-Grund, sonst
# triggert der Hook sich bei jedem Push auf sich selbst.
SKIP='\.(md|bak)$|^dist-firebase/'
TRIGGER='^(src/|public/|index.html$|vite.config|package.json$|firebase.json$|firestore.rules$)'

should_deploy=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  branch="${local_ref#refs/heads/}"
  [ "$branch" != "master" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
    changed=$(git diff-tree --no-commit-id --name-only -r "$range")
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha")
  fi

  relevant=$(echo "$changed" | grep -Ev "$SKIP" || true)
  if echo "$relevant" | grep -Eq "$TRIGGER"; then
    should_deploy=true
  fi
done <<< "$pushed_refs"

if [ "$should_deploy" != true ]; then
  exit 0
fi

if command -v gum >/dev/null 2>&1; then
  gum log --level info "fuel-dev: relevante Änderungen im Push zu master — baue + deploye zu Firebase…"
else
  echo "🔍 fuel-dev: relevante Änderungen im Push zu master — baue + deploye zu Firebase…"
fi

npm run firebase
status=$?

if [ $status -ne 0 ]; then
  echo "❌ npm run firebase fehlgeschlagen — Push wird abgebrochen (kein halb-deployter Stand)." >&2
  echo "   Mit 'git push --no-verify' kannst du den Hook überspringen, falls das Absicht ist." >&2
  exit 1
fi

echo "✅ Deploy abgeschlossen."
exit 0
