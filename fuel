#!/usr/bin/env python3
"""
fuel — Smart logging dispatcher with fzf-browsing.
"""

import json
import os
import subprocess
import sys
from pathlib import Path
import typer

app = typer.Typer(help="Fuel Centre Smart CLI", no_args_is_help=False)

# Resolve to actual fuel-dev directory
FUEL_DIR = Path(__file__).resolve().parent
CATALOG_PATH = Path(os.environ.get("AOS_FUEL_DIR", Path.home() / ".aos" / "fuel")) / "supplements" / "catalog.json"

def load_supplement_ids():
    """Load supplement IDs from catalog."""
    if not CATALOG_PATH.exists():
        return set()
    try:
        data = json.loads(CATALOG_PATH.read_text())
        return {item["id"] for item in data.get("items", [])}
    except:
        return set()

def show_combined_today():
    """Execute 'today' for both meal and supplement scripts."""
    print("\n--- MEALS ---")
    subprocess.run([str(FUEL_DIR / "fuel-meal"), "today"])
    print("\n--- SUPPLEMENTS ---")
    subprocess.run([str(FUEL_DIR / "fuel-supplement"), "today"])

@app.command()
def meal(ctx: typer.Context):
    """Interactive meal browser or explicit routing."""
    subprocess.run([str(FUEL_DIR / "fuel-meal")] + ctx.args)

@app.command()
def supplement(ctx: typer.Context):
    """Interactive supplement browser or explicit routing."""
    subprocess.run([str(FUEL_DIR / "fuel-supplement")] + ctx.args)

@app.command()
def today():
    """Show combined status for today."""
    show_combined_today()

@app.command()
def list():
    """List available supplements."""
    subprocess.run([str(FUEL_DIR / "fuel-supplement"), "list"])

def main():
    # 1. No args -> Open Interactive Supplement Browser (fzf)
    if len(sys.argv) == 1:
        subprocess.run([str(FUEL_DIR / "fuel-supplement")])
        return

    first_arg = sys.argv[1]
    
    # 2. Check for explicit commands
    KNOWN_COMMANDS = {"meal", "supplement", "today", "list", "--help", "-h"}
    if first_arg in KNOWN_COMMANDS:
        app()
        return

    # 3. Smart Routing for Shorthands
    supp_ids = load_supplement_ids()
    
    if first_arg in supp_ids:
        subprocess.run([str(FUEL_DIR / "fuel-supplement")] + sys.argv[1:])
    else:
        # Route to meal log
        subprocess.run([str(FUEL_DIR / "fuel-meal"), "log"] + sys.argv[1:])

if __name__ == "__main__":
    main()
