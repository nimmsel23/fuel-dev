#!/usr/bin/env bash
# fuelctl — Central control for Fuel Centre (Dev, Sync, V2 Prod)
set -euo pipefail

# --- Configuration ---
PORT="${PORT:-9000}"
V2_PORT="${V2_PORT:-7000}"
VITE_PORT="${VITE_PORT:-5173}"
HEALTH_URL="http://127.0.0.1:${PORT}/health"
V2_HEALTH_URL="http://127.0.0.1:${V2_PORT}/health"
# WORKDIR points to the repo root
WORKDIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
BIN_DEVCTL="$WORKDIR/bin/fuel-devctl"
SYNC_SCRIPT="$WORKDIR/scripts/firestore-sync.mjs"

V2_PROD_DIR="/opt/fuel"
V2_SOURCE_DIR="$WORKDIR/v2"
V2_BACKUP_DIR="/opt/fuel_backups"

# --- UI Helpers ---
have_gum() { command -v gum >/dev/null 2>&1; }
msg()  { have_gum && gum log --level info  -- "$*" || printf '\033[1;32m%s\033[0m\n' "$*"; }
warn() { have_gum && gum log --level warn  -- "$*" >&2 || printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
err()  { have_gum && gum log --level error -- "$*" >&2 || printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- Commands ---

cmd_status() {
  "$BIN_DEVCTL" status || true
  
  msg "--- Fuel Centre V2 (STABLE) ---"
  if curl -fsS --connect-timeout 1 --max-time 2 "$V2_HEALTH_URL" >/dev/null 2>&1; then
    msg "● Fuel V2 is running on :$V2_PORT"
  else
    warn "○ Fuel V2 is NOT responding on :$V2_PORT"
  fi

  msg "--- Firestore Sync ---"
  if pgrep -f "firestore-sync.mjs watch" > /dev/null; then
    msg "● Sync Watcher is active"
  else
    warn "○ Sync Watcher is idle"
  fi
}

cmd_dev() {
  local action="${1:-status}"
  case "$action" in
    up|start)
      msg "Starting Fuel Development Stack..."
      "$BIN_DEVCTL" start
      ;;
    down|stop)
      msg "Stopping Fuel Development Stack..."
      "$BIN_DEVCTL" stop
      ;;
    status)
      "$BIN_DEVCTL" status
      ;;
    logs)
      "$BIN_DEVCTL" logs
      ;;
    build)
      local target="${2:-client}"
      "$BIN_DEVCTL" build "$target"
      ;;
    *) die "Usage: fuelctl dev [up|down|status|logs|build]" ;;
  esac
}

cmd_v2() {
  local action="${1:-status}"
  case "$action" in
    deploy)
      msg "🚀 Starting V2 Deployment (Desktop Prod)"
      
      if [[ ! -d "$V2_SOURCE_DIR" ]]; then
        die "Source directory $V2_SOURCE_DIR not found. Did you copy it?"
      fi

      # 1. Backup current V2
      local timestamp
      timestamp=$(date +%Y%m%d_%H%M%S)
      local backup_path="$V2_BACKUP_DIR/fuel_v2_$timestamp"

      if [[ -d "$V2_PROD_DIR" ]]; then
        msg "📦 Creating versioned backup: $backup_path"
        sudo mkdir -p "$V2_BACKUP_DIR"
        sudo cp -a "$V2_PROD_DIR" "$backup_path"
      fi

      # 2. Sync from workspace v2/ to /opt/fuel
      msg "📦 Syncing files from $V2_SOURCE_DIR to $V2_PROD_DIR"
      sudo rsync -av --delete \
        --exclude '.git' \
        --exclude 'node_modules' \
        --exclude 'data' \
        --exclude '.claude' \
        --exclude '.archiv' \
        --exclude '.bak' \
        "$V2_SOURCE_DIR/" "$V2_PROD_DIR/"

      # 3. Production setup in /opt/fuel
      msg "📦 Finalizing production environment in $V2_PROD_DIR"
      sudo chown -R alpha:alpha "$V2_PROD_DIR"
      (
        cd "$V2_PROD_DIR"
        msg "Running npm install..."
        npm install --production --silent
        msg "Building frontend..."
        npm run build > /dev/null
      )

      # 4. Restart service
      msg "🔄 Restarting Fuel V2 service"
      sudo systemctl restart fuel-v2.service
      
      msg "✅ V2 Deployment complete. Running on Port $V2_PORT"
      ;;
    status)
      cmd_status
      ;;
    logs)
      sudo journalctl -u fuel-v2.service -f
      ;;
    *) die "Usage: fuelctl v2 [deploy|status|logs]" ;;
  esac
}

cmd_sync() {
  local action="${1:-menu}"
  case "$action" in
    push) node "$SYNC_SCRIPT" push ;;
    pull) node "$SYNC_SCRIPT" pull ;;
    watch) node "$SYNC_SCRIPT" watch ;;
    menu)
      if have_gum; then
        local choice
        choice=$(gum choose "Push (Local -> Cloud)" "Pull (Cloud -> Local)" "Watch (Auto-Sync)")
        case "$choice" in
          "Push (Local -> Cloud)") node "$SYNC_SCRIPT" push ;;
          "Pull (Cloud -> Local)") node "$SYNC_SCRIPT" pull ;;
          "Watch (Auto-Sync)") node "$SYNC_SCRIPT" watch ;;
        esac
      else
        die "Usage: fuelctl sync [push|pull|watch]"
      fi
      ;;
  esac
}

cmd_help() {
  cat <<EOF
fuelctl — Universal System Control for Fuel Centre

Usage:
  fuelctl status          Check all systems (Dev, V2, Sync)
  fuelctl dev up          Start development stack (Port 9000)
  fuelctl dev down        Stop development stack
  fuelctl dev logs        Tail development logs
  fuelctl dev build       Build client PWA for Firebase (V3)
  fuelctl v2 deploy       Backup and update Desktop Prod (/opt/fuel)
  fuelctl v2 logs         Tail V2 production logs
  fuelctl sync [action]   Cloud sync (push, pull, watch)
  fuelctl help            Show this message

Dev Stack:    http://127.0.0.1:$PORT
V2 Prod:      http://127.0.0.1:$V2_PORT
EOF
}

# --- Dispatcher ---
case "${1:-status}" in
  status)         cmd_status ;;
  dev)            cmd_dev "${2:-}" "${3:-}" ;;
  v2)             cmd_v2 "${2:-}" ;;
  up|start)       cmd_dev up ;;    # Legacy compatibility
  down|stop)      cmd_dev down ;;  # Legacy compatibility
  restart)        cmd_dev down && cmd_dev up ;;
  sync)           cmd_sync "${2:-}" ;;
  logs)           cmd_dev logs ;;
  help|--help|-h) cmd_help ;;
  *)              cmd_help; exit 1 ;;
esac
