#!/usr/bin/env python3
"""
fuelctl — Universal System Control for Fuel Centre (Python Edition)
Central control für: dev (v3 entrypoint + v4 backend, diese Maschine), prod
(fuel.service, diese Maschine, /opt/fuel), cloud (Firebase Hosting,
fuel-vos.web.app -- via `sync`, siehe fuelctl sync/deploy:cloud in package.json).
"local" fällt als Bezeichnung weg, weil dev + prod ohnehin beide auf dieser
Maschine laufen -- der einzige echte Gegenpol dazu ist "cloud".
"""

import os
import subprocess
import sys
from pathlib import Path
from typing import Optional

import typer
from wasabi import Printer

msg = Printer()
app = typer.Typer(help="Fuel Centre Universal Control", no_args_is_help=True)

# ── Config ────────────────────────────────────────────────────────────────────

PROD_SERVICE = "fuel.service"  # systemd unit (vormals fuel-v2.service, umbenannt -- Kontrolle via fuel-prodctl, nicht hier)


def _unit_port(service: str, fallback: str) -> str:
    """Liest den Port live aus der systemd-Unit (Environment=PORT=X) statt ihn
    hier als Konstante zu wiederholen -- ändert sich der Port in der Unit,
    zeigt fuelctl automatisch den richtigen Wert statt zu lügen."""
    try:
        out = subprocess.run(
            ["systemctl", "cat", f"{service}.service"], capture_output=True, text=True
        ).stdout
        import re
        m = re.search(r"Environment=PORT=(\d+)", out)
        if m:
            return m.group(1)
    except Exception:
        pass
    return fallback


# PORT (dev) hat keine systemd-Unit (fuel-devctl startet im Vordergrund) --
# hier bleibt die env-Var/Default die einzige Quelle.
PORT = os.getenv("PORT", "9000")
PROD_PORT = os.getenv("PROD_PORT") or _unit_port(PROD_SERVICE, "7000")
CATALOG_PORT = "9050"

HEALTH_URL = f"http://127.0.0.1:{PORT}/health"
PROD_HEALTH_URL = f"http://127.0.0.1:{PROD_PORT}/health"

WORKDIR = Path(__file__).resolve().parent.parent
BIN_DEVCTL = WORKDIR / "bin" / "fuel-devctl"
BIN_PRODCTL = WORKDIR / "bin" / "fuel-prodctl"
SYNC_SCRIPT = WORKDIR / "scripts" / "firestore-sync.mjs"
CATALOG_SERVER_SCRIPT = WORKDIR / "fuel-catalog-server.py"

# ── Helpers ───────────────────────────────────────────────────────────────────

def gum_log(level: str, text: str):
    try:
        subprocess.run(["gum", "log", f"--level={level}", text])
    except:
        if level == "info": msg.info(text)
        elif level == "warn": msg.warn(text)
        elif level == "error": msg.fail(text)

def check_url(url: str) -> bool:
    import urllib.request
    try:
        with urllib.request.urlopen(url, timeout=1):
            return True
    except:
        return False

# ── Commands ──────────────────────────────────────────────────────────────────

@app.command()
def status():
    """Check all systems (Dev, Prod, Sync)."""
    # 1. Dev Stack
    subprocess.run([str(BIN_DEVCTL), "status"])

    # 2. Prod
    msg.divider("Fuel Centre · Prod (Desktop)")
    if check_url(PROD_HEALTH_URL):
        msg.good(f"Fuel prod is running on :{PROD_PORT}")
    else:
        msg.warn(f"Fuel prod is NOT responding on :{PROD_PORT}")

    # 3. Catalog Server
    msg.divider("Catalog Server")
    if check_url(f"http://127.0.0.1:{CATALOG_PORT}/catalogs/nutrition"):
        msg.good(f"Catalog Server is running on :{CATALOG_PORT}")
    else:
        msg.warn(f"Catalog Server is NOT responding on :{CATALOG_PORT}")

    # 4. Firestore Sync
    msg.divider("Firestore Sync")
    # Check if watcher is running
    res = subprocess.run(["pgrep", "-f", "firestore-sync.mjs watch"], capture_output=True)
    if res.returncode == 0:
        msg.good("Sync Watcher is active")
    else:
        msg.warn("Sync Watcher is idle")

@app.command(context_settings={"allow_extra_args": True, "ignore_unknown_options": True})
def dev(
    ctx: typer.Context,
    action: str = typer.Argument("status", help="up, down, restart, status, logs, build, deploy, foreground"),
):
    """Manage the development stack (v3 entrypoint by default, v4 optional).

    Extra flags pass through to fuel-devctl, e.g.:
      fuelctl dev start --v4        (also start v4)
      fuelctl dev status --no-v3    (only show v4)
      fuelctl dev logs v4           (tail v4 logs)
      fuelctl dev foreground v4     (foreground reload for v4)
    """
    cmd_map = {
        "up": "start",
        "start": "start",
        "down": "stop",
        "stop": "stop",
        "restart": "restart",
        "status": "status",
        "logs": "logs",
        "build": "build",
        "deploy": "deploy",
        "foreground": "dev",
    }
    target = cmd_map.get(action)
    if target:
        subprocess.run([str(BIN_DEVCTL), target, *ctx.args])
    else:
        msg.fail(f"Unknown dev action: {action}")

@app.command(context_settings={"allow_extra_args": True, "ignore_unknown_options": True})
def prod(
    ctx: typer.Context,
    action: str = typer.Argument("status", help="status, logs, restart, deploy, install"),
):
    """Manage the prod stack (fuel.service, /opt/fuel) -- delegiert 1:1 an fuel-prodctl."""
    if not BIN_PRODCTL.exists():
        msg.fail(f"fuel-prodctl not found at {BIN_PRODCTL}")
        raise typer.Exit(1)
    subprocess.run([str(BIN_PRODCTL), action, *ctx.args])


# Backwards-compat aliases: `fuelctl local …` / `fuelctl v2 …` → `fuelctl prod …`
# ("local" war die alte, verwirrende Bezeichnung -- es gibt nur dev + prod)
@app.command(name="local", hidden=True)
def local_alias(ctx: typer.Context, action: str = typer.Argument("status")):
    """Deprecated: use `fuelctl prod` instead."""
    msg.warn("`fuelctl local` is deprecated. Use `fuelctl prod` instead.")
    prod(ctx, action)


@app.command(name="v2", hidden=True)
def v2_alias(ctx: typer.Context, action: str = typer.Argument("status")):
    """Deprecated: use `fuelctl prod` instead."""
    msg.warn("`fuelctl v2` is deprecated. Use `fuelctl prod` instead.")
    prod(ctx, action)

@app.command()
def sync(action: Optional[str] = typer.Argument(None, help="push, pull, watch")):
    """Manage Firestore synchronization."""
    if action is None:
        try:
            choice = subprocess.run(
                ["gum", "choose", "Push (Local -> Cloud)", "Pull (Cloud -> Local)", "Watch (Auto-Sync)"],
                capture_output=True, text=True
            ).stdout.strip()
            
            if "Push" in choice: action = "push"
            elif "Pull" in choice: action = "pull"
            elif "Watch" in choice: action = "watch"
            else: return
        except:
            msg.info("Usage: fuelctl sync [push|pull|watch]")
            return

    if action == "push":
        subprocess.run(["node", str(SYNC_SCRIPT), "push"])
    elif action == "pull":
        subprocess.run(["node", str(SYNC_SCRIPT), "pull"])
    elif action == "watch":
        subprocess.run(["node", str(SYNC_SCRIPT), "watch"])

@app.command()
def catalog(action: str = typer.Argument("status", help="start, stop, status")):
    """Manage the catalog server."""
    if action == "start":
        msg.info(f"Starting Catalog Server on port {CATALOG_PORT}...")
        subprocess.Popen([sys.executable, str(CATALOG_SERVER_SCRIPT)], 
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    elif action == "stop":
        msg.info("Stopping Catalog Server...")
        subprocess.run(["pkill", "-f", f"python3 {CATALOG_SERVER_SCRIPT}"])
    elif action == "status":
        if check_url(f"http://127.0.0.1:{CATALOG_PORT}/catalogs/nutrition"):
            msg.good(f"Catalog Server is running on :{CATALOG_PORT}")
        else:
            msg.warn("Catalog Server is NOT running")

if __name__ == "__main__":
    app()
