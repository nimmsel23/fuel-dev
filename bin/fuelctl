#!/usr/bin/env python3
"""
fuelctl — Universal System Control for Fuel Centre (Python Edition)
Central control für: dev (v3 entrypoint + v4 backend, diese Maschine), prod
(fuel.service, diese Maschine, /opt/fuel), cloud (Firebase Hosting,
fuel-vos.web.app -- via `cloud`, siehe fuelctl cloud/deploy:cloud in package.json).
"local" fällt als Bezeichnung weg, weil dev + prod ohnehin beide auf dieser
Maschine laufen -- der einzige echte Gegenpol dazu ist "cloud".
"""

import json
import os
import subprocess
from pathlib import Path
from typing import Optional

import typer
from wasabi import Printer

msg = Printer()
app = typer.Typer(help="Fuel Centre Universal Control", no_args_is_help=True)

# ── Config ────────────────────────────────────────────────────────────────────

PROD_SERVICE = "fuel.service"  # systemd unit (vormals fuel-v2.service, umbenannt -- Kontrolle via fuel-prodctl, nicht hier)
PY_PROD_SERVICE = "fuel-python.service"


def _unit_port(service: str, fallback: str) -> str:
    """Liest den Port live aus der systemd-Unit (Environment=PORT=X) statt ihn
    hier als Konstante zu wiederholen -- ändert sich der Port in der Unit,
    zeigt fuelctl automatisch den richtigen Wert statt zu lügen."""
    try:
        out = subprocess.run(
            ["systemctl", "cat", f"{service}.service"], capture_output=True, text=True
        ).stdout
        import re
        m = re.search(r"Environment=PORT=(\d+)", out)
        if m:
            return m.group(1)
    except Exception:
        pass
    return fallback


# PORT (dev) hat keine systemd-Unit (fuel-devctl startet im Vordergrund) --
# hier bleibt die env-Var/Default die einzige Quelle.
PORT = os.getenv("PORT", "9000")
PROD_PORT = os.getenv("PROD_PORT") or _unit_port(PROD_SERVICE, "7000")
PY_PROD_PORT = os.getenv("PY_PROD_PORT") or _unit_port(PY_PROD_SERVICE, "4000")
HEALTH_URL = f"http://127.0.0.1:{PORT}/health"
PROD_HEALTH_URL = f"http://127.0.0.1:{PROD_PORT}/health"
PY_PROD_HEALTH_URL = f"http://127.0.0.1:{PY_PROD_PORT}/health"
PROD_COACH_HEALTH_URL = f"http://127.0.0.1:{PROD_PORT}/coach/health"

WORKDIR = Path(__file__).resolve().parent.parent
BIN_DEVCTL = WORKDIR / "bin" / "fuel-devctl"
BIN_PRODCTL = WORKDIR / "bin" / "fuel-prodctl"
SYNC_SCRIPT = WORKDIR / "scripts" / "firestore-sync.mjs"
# ── Helpers ───────────────────────────────────────────────────────────────────

def gum_log(level: str, text: str):
    try:
        subprocess.run(["gum", "log", f"--level={level}", text])
    except:
        if level == "info": msg.info(text)
        elif level == "warn": msg.warn(text)
        elif level == "error": msg.fail(text)

def check_url(url: str) -> bool:
    try:
        res = subprocess.run(
            ["curl", "-fsS", "-o", "/dev/null", "--max-time", "1", url],
            capture_output=True,
            text=True,
        )
        return res.returncode == 0
    except Exception:
        return False


def get_json(url: str) -> Optional[dict]:
    import urllib.request

    try:
        with urllib.request.urlopen(url, timeout=1) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception:
        return None

# ── Commands ──────────────────────────────────────────────────────────────────

@app.command()
def status():
    """Check all systems (Dev, Prod, Cloud)."""
    # 1. Dev Stack
    subprocess.run([str(BIN_DEVCTL), "status"])

    # 2. Prod
    prod_coach_health = get_json(PROD_COACH_HEALTH_URL)
    msg.divider("Fuel Centre · Prod (Desktop)")
    if prod_coach_health:
        msg.good(f"Fuel prod v3 is running on :{PROD_PORT}")
    else:
        msg.warn(f"Fuel prod v3 is NOT responding on :{PROD_PORT}")
    if check_url(PY_PROD_HEALTH_URL):
        msg.good(f"Fuel prod v4 is running on :{PY_PROD_PORT}")
    else:
        msg.warn(f"Fuel prod v4 is NOT responding on :{PY_PROD_PORT}")

    # 3. Catalogs
    msg.divider("Catalogs")
    catalogs = (prod_coach_health or {}).get("catalogs")
    if isinstance(catalogs, dict):
        nutrition_count = catalogs.get("nutrition", 0)
        supplements_count = catalogs.get("supplements", 0)
        msg.good(
            f"Prod runtime catalogs loaded: nutrition={nutrition_count}, supplements={supplements_count}"
        )
    else:
        msg.warn("Catalog state unavailable from prod runtime")

    # 4. Firestore Cloud Transport
    msg.divider("Firestore Cloud")
    firestore = (prod_coach_health or {}).get("firestoreAdmin")
    if isinstance(firestore, dict) and firestore.get("connected"):
        active_uids = firestore.get("activeUids") or firestore.get("uids") or []
        push_count = firestore.get("pushCount", 0)
        catalog_push_count = firestore.get("catalogPushCount", 0)
        runtime_push_count = firestore.get("runtimePushCount", 0)
        listener_count = firestore.get("listenerCount", 0)
        msg.good(
            "Prod Firestore sync active: "
            f"listeners={listener_count}, "
            f"pushes(catalog={catalog_push_count}, runtime={runtime_push_count}, total={push_count}), "
            f"users={len(active_uids)}"
        )
    else:
        msg.warn("Prod Firestore sync is not connected")

@app.command(context_settings={"allow_extra_args": True, "ignore_unknown_options": True})
def dev(
    ctx: typer.Context,
    action: str = typer.Argument("status", help="up, down, restart, status, logs, build, deploy, foreground"),
):
    """Manage the development stack (v3 entrypoint by default, v4 optional).

    Extra flags pass through to fuel-devctl, e.g.:
      fuelctl dev start --v4        (also start v4)
      fuelctl dev status --no-v3    (only show v4)
      fuelctl dev logs v4           (tail v4 logs)
      fuelctl dev foreground v4     (foreground reload for v4)
    """
    cmd_map = {
        "up": "start",
        "start": "start",
        "down": "stop",
        "stop": "stop",
        "restart": "restart",
        "status": "status",
        "logs": "logs",
        "build": "build",
        "deploy": "deploy",
        "foreground": "dev",
    }
    target = cmd_map.get(action)
    if target:
        subprocess.run([str(BIN_DEVCTL), target, *ctx.args])
    else:
        msg.fail(f"Unknown dev action: {action}")

@app.command(context_settings={"allow_extra_args": True, "ignore_unknown_options": True})
def prod(
    ctx: typer.Context,
    action: str = typer.Argument("status", help="status, logs, restart, deploy, install"),
):
    """Manage the prod stack (fuel.service, /opt/fuel) -- delegiert 1:1 an fuel-prodctl."""
    if not BIN_PRODCTL.exists():
        msg.fail(f"fuel-prodctl not found at {BIN_PRODCTL}")
        raise typer.Exit(1)
    subprocess.run([str(BIN_PRODCTL), action, *ctx.args])


# Backwards-compat aliases: `fuelctl local …` / `fuelctl v2 …` → `fuelctl prod …`
# ("local" war die alte, verwirrende Bezeichnung -- es gibt nur dev + prod)
@app.command(name="local", hidden=True)
def local_alias(ctx: typer.Context, action: str = typer.Argument("status")):
    """Deprecated: use `fuelctl prod` instead."""
    msg.warn("`fuelctl local` is deprecated. Use `fuelctl prod` instead.")
    prod(ctx, action)


@app.command(name="v2", hidden=True)
def v2_alias(ctx: typer.Context, action: str = typer.Argument("status")):
    """Deprecated: use `fuelctl prod` instead."""
    msg.warn("`fuelctl v2` is deprecated. Use `fuelctl prod` instead.")
    prod(ctx, action)

@app.command()
def cloud(action: Optional[str] = typer.Argument(None, help="push, pull, watch")):
    """Manage cloud transport to and from Firestore."""
    if action is None:
        try:
            choice = subprocess.run(
                ["gum", "choose", "Push (Local -> Cloud)", "Pull (Cloud -> Local)", "Watch (Auto-Sync)"],
                capture_output=True, text=True
            ).stdout.strip()
            
            if "Push" in choice: action = "push"
            elif "Pull" in choice: action = "pull"
            elif "Watch" in choice: action = "watch"
            else: return
        except:
            msg.info("Usage: fuelctl cloud [push|pull|watch]")
            return

    if action == "push":
        subprocess.run(["node", str(SYNC_SCRIPT), "push"])
    elif action == "pull":
        subprocess.run(["node", str(SYNC_SCRIPT), "pull"])
    elif action == "watch":
        subprocess.run(["node", str(SYNC_SCRIPT), "watch"])
    else:
        msg.fail(f"Unknown cloud action: {action}")


@app.command(name="sync", hidden=True)
def sync_alias(action: Optional[str] = typer.Argument(None, help="push, pull, watch")):
    """Deprecated: use `fuelctl cloud` instead."""
    msg.warn("`fuelctl sync` is deprecated. Use `fuelctl cloud` instead.")
    cloud(action)

@app.command()
def catalog(action: str = typer.Argument("status", help="start, stop, status")):
    """Deprecated: catalogs are served from the prod runtime, not a separate server."""
    if action == "status":
        prod_coach_health = get_json(PROD_COACH_HEALTH_URL)
        catalogs = (prod_coach_health or {}).get("catalogs")
        if isinstance(catalogs, dict):
            msg.good(
                f"Prod runtime catalogs: nutrition={catalogs.get('nutrition', 0)}, supplements={catalogs.get('supplements', 0)}"
            )
        else:
            msg.warn("Catalog state unavailable from prod runtime")
        return

    msg.warn("Separate catalog server no longer exists. Catalogs are handled by the prod runtime.")

if __name__ == "__main__":
    app()
