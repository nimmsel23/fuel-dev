#!/usr/bin/env python3
"""
fuel-prodctl — Fuel Prod Controller (system-scope service)

Kontrolliert den tatsächlich laufenden Prod-Service, getrennt vom
fuel-devctl-Stack (falls vorhanden). Deploy-Pfad laut deploy.sh:
  ~/fuel-dev (dev) -> ~/.local/fuel (staging, git-versioniert)
  -> /opt/fuel (Node prod) + /opt/fuel-python (Python-Backend)

  - fuel.service :7000  system-scope, Node aus /opt/fuel (sudo für restart/stop)
    (vormals fuel-v2.service, umbenannt weil der Compose-/Unit-Name nie
    "v2" tragen sollte -- kein zweiter Fuel-Service existiert)

Deploy/Install-Logik liegt in deploy.sh; dieser Controller delegiert nur.
"""

import subprocess
from pathlib import Path

import typer
from wasabi import Printer

msg = Printer()

app = typer.Typer(help="Fuel Prod Controller", no_args_is_help=True)

# fuel-prodctl liegt in bin/, deploy.sh eine Ebene höher im Repo-Root.
DEV_DIR = Path(__file__).resolve().parent.parent

PROD_SERVICE = "fuel.service"  # system-scope, sudo


def _systemctl(action: str, unit: str) -> int:
    return subprocess.run(["sudo", "systemctl", action, unit]).returncode


@app.command()
def status():
    """Status des Prod-Service."""
    result = subprocess.run(
        ["systemctl", "is-active", PROD_SERVICE], capture_output=True, text=True
    )
    state = result.stdout.strip() or "unknown"
    if state == "active":
        msg.good(f"{PROD_SERVICE}: {state}")
    else:
        msg.fail(f"{PROD_SERVICE}: {state}")


@app.command()
def logs(
    follow: bool = typer.Option(True, "-f/--no-follow", help="Follow log output"),
    lines: int = typer.Option(50, "-n", help="Number of lines when not following"),
):
    """Live-Logs des Prod-Service (journalctl -f)."""
    cmd = ["journalctl", "-u", PROD_SERVICE]
    if follow:
        cmd += ["-f", "--no-pager"]
    else:
        cmd += ["-n", str(lines), "--no-pager"]
    subprocess.run(cmd)


@app.command()
def restart():
    """Restartet den Prod-Service (sudo)."""
    msg.info(f"Restarting {PROD_SERVICE} (sudo)")
    rc = _systemctl("restart", PROD_SERVICE)
    if rc == 0:
        msg.good(f"{PROD_SERVICE} restarted")
    else:
        msg.fail(f"{PROD_SERVICE} restart failed (exit {rc})")
        raise typer.Exit(rc)


def _run_deploy_sh(*args: str) -> int:
    deploy_script = DEV_DIR / "deploy.sh"
    if not deploy_script.exists():
        msg.fail(f"deploy.sh not found in {DEV_DIR}")
        raise typer.Exit(1)
    return subprocess.run(["bash", str(deploy_script), *args], cwd=DEV_DIR).returncode


@app.command()
def deploy(
    install: bool = typer.Option(
        False, "--install", help="Vorher die systemd-Unit installieren/aktualisieren"
    )
):
    """Deployt ~/.local/fuel nach /opt/fuel[-python]; optional inkl. Unit-Install."""
    args = ["prod"]
    if install:
        args.append("--install")
    rc = _run_deploy_sh(*args)
    if rc != 0:
        raise typer.Exit(rc)


@app.command(name="install")
def install_cmd(
    deploy: bool = typer.Option(
        False, "--deploy", help="Danach direkt deployen (deploy.sh ausführen)"
    )
):
    """Installiert/aktualisiert die fuel.service-Unit via deploy.sh."""
    if deploy:
        rc = _run_deploy_sh("prod", "--install")
    else:
        rc = _run_deploy_sh("prod", "--install-only")
    if rc != 0:
        raise typer.Exit(rc)


if __name__ == "__main__":
    app()
