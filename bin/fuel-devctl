#!/usr/bin/env python3
"""
fuel-devctl — Python-powered Fuel Centre Stack Control
Controls: frontend server (:9000) + backend API (:4000, backend/).
The old v3/v4 naming was misleading in the control layer. The backend has no
systemd unit yet and is managed via Popen+PIDFILE.
"""

import os
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional

import psutil
import typer
from wasabi import Printer

msg = Printer()

app = typer.Typer(help="Fuel Centre Stack Control (Python Edition)", no_args_is_help=True)

# ── Config ────────────────────────────────────────────────────────────────────

PORT = os.getenv("PORT", "9000")
HEALTH_URL = f"http://127.0.0.1:{PORT}/health"
DEV_DIR = Path(__file__).resolve().parent.parent
LOGFILE = Path("/tmp/fuelctx-dev.log")
PIDFILE = Path("/tmp/fuelctx-dev.pid")
DEPLOY_SCRIPT = DEV_DIR / "deploy.sh"

BACKEND_PORT = os.getenv("FUEL_BACKEND_PORT", os.getenv("FUEL_V4_PORT", "4000"))
BACKEND_HEALTH_URL = f"http://127.0.0.1:{BACKEND_PORT}/health"
BACKEND_DIR = DEV_DIR / "backend"
BACKEND_UVICORN = BACKEND_DIR / ".venv" / "bin" / "uvicorn"
BACKEND_LOGFILE = Path("/tmp/fuel-backend-dev.log")
BACKEND_PIDFILE = Path("/tmp/fuel-backend-dev.pid")

# ── Helpers ───────────────────────────────────────────────────────────────────

def gum_log(level: str, text: str):
    """Wrapper for gum log if available."""
    try:
        subprocess.run(["gum", "log", f"--level={level}", text])
    except:
        # Fallback to wasabi if gum fails
        if level == "info": msg.info(text)
        elif level == "warn": msg.warn(text)
        elif level == "error": msg.fail(text)

def get_pid() -> Optional[int]:
    if PIDFILE.exists():
        try:
            return int(PIDFILE.read_text().strip())
        except ValueError:
            return None
    return None

def get_backend_pid() -> Optional[int]:
    if BACKEND_PIDFILE.exists():
        try:
            return int(BACKEND_PIDFILE.read_text().strip())
        except ValueError:
            return None
    return None

def is_backend_running() -> bool:
    import urllib.request
    try:
        with urllib.request.urlopen(BACKEND_HEALTH_URL, timeout=1):
            return True
    except Exception:
        return False

def is_running() -> bool:
    import urllib.request
    try:
        with urllib.request.urlopen(HEALTH_URL, timeout=1):
            return True
    except:
        return False

def kill_leftover_processes() -> list[int]:
    """Kill only node/vite/nodemon processes whose cwd sits inside this repo.

    Was previously a blind `pkill -f "...|vite"` — matched against the full
    cmdline of every process on the machine, so it also killed vite/node
    dev servers of unrelated AlphaOS pillars (fitness-dev, habit-dev, ...).
    Scoping by cwd via psutil fixes that without losing the "catch orphans
    that escaped the process group" safety net.
    """
    dev_dir_str = str(DEV_DIR)
    killed = []
    for proc in psutil.process_iter(["pid", "name", "cmdline", "cwd"]):
        try:
            info = proc.info
            name = (info.get("name") or "").lower()
            cmdline = " ".join(info.get("cmdline") or [])
            if not any(k in name or k in cmdline.lower() for k in ("node", "vite", "nodemon")):
                continue
            cwd = info.get("cwd") or ""
            if not cwd.startswith(dev_dir_str) and dev_dir_str not in cmdline:
                continue
            proc.terminate()
            killed.append(info["pid"])
        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
            continue

    if killed:
        time.sleep(0.5)
        for pid in killed:
            try:
                p = psutil.Process(pid)
                if p.is_running():
                    p.kill()
            except psutil.NoSuchProcess:
                pass
    return killed

# ── Backend Helpers ───────────────────────────────────────────────────────────

def _start_backend():
    if is_backend_running():
        msg.warn(f"backend already running on port {BACKEND_PORT}")
        return
    if not BACKEND_UVICORN.exists():
        msg.fail(f"backend venv not found ({BACKEND_UVICORN}) — run: python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt")
        return

    BACKEND_LOGFILE.touch()
    with open(BACKEND_LOGFILE, "w") as f:
        f.truncate(0)

    gum_log("info", f"Starting backend (FastAPI) in background (Logs: {BACKEND_LOGFILE})...")
    proc = subprocess.Popen(
        [str(BACKEND_UVICORN), "backend.api.main:app", "--port", BACKEND_PORT],
        stdout=open(BACKEND_LOGFILE, "a"),
        stderr=subprocess.STDOUT,
        cwd=DEV_DIR,
        start_new_session=True,
    )
    BACKEND_PIDFILE.write_text(str(proc.pid))

    for i in range(15):
        time.sleep(1)
        if is_backend_running():
            msg.good("backend is now online and healthy!")
            return
        if i % 5 == 0 and i > 0:
            msg.info(f"Still waiting for backend ({i}s)...")
    msg.fail("backend failed to start within 15 seconds. Please check logs.")
    msg.info(f"Command: tail -n 20 {BACKEND_LOGFILE}")


def _stop_backend():
    pid = get_backend_pid()
    if pid:
        gum_log("warn", f"Terminating backend process group for PID {pid}...")
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
            time.sleep(1)
            if os.path.exists(f"/proc/{pid}"):
                os.killpg(os.getpgid(pid), signal.SIGKILL)
        except ProcessLookupError:
            pass
        except Exception as e:
            msg.warn(f"Error while killing backend process group: {e}")
    if BACKEND_PIDFILE.exists():
        BACKEND_PIDFILE.unlink()
    msg.good("backend stopped.")


# ── Commands ──────────────────────────────────────────────────────────────────

@app.command()
def status(
    frontend: bool = typer.Option(True, "--frontend/--no-frontend", help="Show frontend server (:9000)"),
    backend: bool = typer.Option(True, "--backend/--no-backend", help="Show backend API (:4000)"),
):
    """Check the status of the local frontend server and backend API."""
    msg.divider("System Status")
    if frontend:
        if is_running():
            pid = get_pid()
            msg.good(f"frontend server is online on port {PORT}" + (f" — PID {pid}" if pid else ""))
        else:
            msg.warn(f"frontend server is not responding on port {PORT}")
    if backend:
        if is_backend_running():
            pid = get_backend_pid()
            msg.good(f"backend API is online on port {BACKEND_PORT}" + (f" — PID {pid}" if pid else ""))
        else:
            msg.warn(f"backend API is not responding on port {BACKEND_PORT}")

@app.command()
def start(
    frontend: bool = typer.Option(True, "--frontend/--no-frontend", help="Start frontend server (:9000)"),
    backend: bool = typer.Option(False, "--backend/--no-backend", help="Also start backend API (:4000)"),
):
    """Start the local frontend server and, if requested, the backend API."""
    if frontend:
        if is_running():
            msg.warn(f"frontend server is already running on port {PORT}")
        else:
            os.chdir(DEV_DIR)

            # Ensure logfile is fresh
            try:
                LOGFILE.touch()
                with open(LOGFILE, "w") as f:
                    f.truncate(0)
            except Exception as e:
                msg.fail(f"Could not prepare logfile {LOGFILE}: {e}")
                raise typer.Exit(1)

            gum_log("info", f"Starting frontend server in background (Logs: {LOGFILE})...")

            # Using start_new_session=True to detach from this terminal
            proc = subprocess.Popen(
                ["npm", "run", "dev"],
                stdout=open(LOGFILE, "a"),
                stderr=subprocess.STDOUT,
                cwd=DEV_DIR,
                start_new_session=True
            )

            PIDFILE.write_text(str(proc.pid))

            # Wait for startup
            msg.info("Waiting for frontend server to become healthy...")
            for i in range(15):
                time.sleep(1)
                if is_running():
                    msg.good("frontend server is now online and healthy!")
                    break
                if i % 5 == 0 and i > 0:
                    msg.info(f"Still waiting ({i}s)...")
            else:
                msg.fail("frontend server failed to start within 15 seconds. Please check logs.")
                msg.info(f"Command: tail -n 20 {LOGFILE}")
    if backend:
        _start_backend()

@app.command()
def stop(
    frontend: bool = typer.Option(True, "--frontend/--no-frontend", help="Stop frontend server (:9000)"),
    backend: bool = typer.Option(True, "--backend/--no-backend", help="Stop backend API (:4000)"),
):
    """Stop the local frontend server and backend API."""
    if frontend:
        pid = get_pid()

        if pid:
            gum_log("warn", f"Terminating process group for PID {pid}...")
            try:
                os.killpg(os.getpgid(pid), signal.SIGTERM)
                time.sleep(1)
                # Check if still alive
                if os.path.exists(f"/proc/{pid}"):
                    os.killpg(os.getpgid(pid), signal.SIGKILL)
            except ProcessLookupError:
                pass
            except Exception as e:
                msg.warn(f"Error while killing process group: {e}")

        # Cleanup of leftover Node/Vite processes — scoped to this repo (see
        # kill_leftover_processes() docstring for why this used to be too broad).
        msg.info("Cleaning up leftover Node.js and Vite processes (scoped to this repo)...")
        killed = kill_leftover_processes()
        if killed:
            msg.info(f"Killed {len(killed)} leftover process(es): {killed}")

        if PIDFILE.exists():
            PIDFILE.unlink()
        msg.good("frontend server stopped.")
    if backend:
        _stop_backend()

@app.command()
def restart(
    frontend: bool = typer.Option(True, "--frontend/--no-frontend", help="Restart frontend server (:9000)"),
    backend: bool = typer.Option(False, "--backend/--no-backend", help="Also restart backend API (:4000)"),
):
    """Stop and then start the local frontend server and backend API."""
    stop(frontend=frontend, backend=backend)
    time.sleep(1)
    start(frontend=frontend, backend=backend)

@app.command()
def logs(
    service: str = typer.Argument("frontend", help="Which service: frontend | backend"),
    n: int = typer.Option(50, "--lines", "-n", help="Number of lines to show initially"),
):
    """Tail the stack logs."""
    target = BACKEND_LOGFILE if service == "backend" else LOGFILE
    if not target.exists():
        msg.fail(f"Log file not found at {target}")
        return

    msg.divider(f"Log Stream ({service}, Ctrl+C to stop)")
    try:
        subprocess.run(["tail", f"-n{n}", "-f", str(target)])
    except KeyboardInterrupt:
        print("\n")
        msg.info("Stopped tailing logs.")

@app.command()
def build():
    """Run the production build for the UI."""
    msg.info("Running UI build...")
    subprocess.run(["npm", "run", "build"], cwd=DEV_DIR)


@app.command()
def deploy():
    """Builds in ~/fuel-dev and syncs the result to ~/.local/fuel."""
    if not DEPLOY_SCRIPT.exists():
        msg.fail(f"deploy.sh not found in {DEV_DIR}")
        raise typer.Exit(1)
    rc = subprocess.run(["bash", str(DEPLOY_SCRIPT), "staging"], cwd=DEV_DIR).returncode
    if rc != 0:
        raise typer.Exit(rc)

@app.command()
def dev(target: str = typer.Argument("frontend", help="frontend | backend — welcher Prozess läuft im Vordergrund")):
    """Run the frontend server or backend API in the foreground (for debugging)."""
    if target == "backend":
        if not BACKEND_UVICORN.exists():
            msg.fail(f"backend venv not found ({BACKEND_UVICORN}) — run: python3 -m venv backend/.venv && backend/.venv/bin/pip install -r backend/requirements.txt")
            raise typer.Exit(1)
        if is_backend_running():
            msg.info("Stopping backgrounded backend (port freed for foreground reload)...")
            _stop_backend()
        msg.divider("Foreground Mode (backend)")
        try:
            subprocess.run([str(BACKEND_UVICORN), "backend.api.main:app", "--port", BACKEND_PORT, "--reload"], cwd=DEV_DIR)
        except KeyboardInterrupt:
            print("\n")
            msg.info("Foreground process stopped by user.")
        return

    msg.divider("Foreground Mode (frontend)")
    try:
        subprocess.run(["npm", "run", "dev"], cwd=DEV_DIR)
    except KeyboardInterrupt:
        print("\n")
        msg.info("Foreground process stopped by user.")

if __name__ == "__main__":
    app()
