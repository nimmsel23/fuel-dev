#!/usr/bin/env python3
"""Fuel entry point.

Control-Kommandos (`fuel dev ...`, `fuel prod ...`, `fuel status`, `fuel cloud ...`)
delegieren an `fuelctl`, damit `fuel` und `fuelctl` nicht auseinanderlaufen.
Die eigentliche Logging-CLI bleibt weiter in `fuel.dispatch`.
"""
import subprocess
import sys
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
# TODO(2026-09-11, ungeklärt — mit User besprechen): "sync" und "catalog"
# kollidieren mit gleichnamigen, aber inhaltlich anderen Typer-Commands in
# fuel/dispatch.py (Tages-Nutrition-Sync bzw. TUI-Catalog-Editor) — die sind
# über `fuel <name>` aktuell NIE erreichbar, weil hier immer zuerst an
# fuelctl delegiert wird. Details siehe TODO-Kommentare bei den jeweiligen
# Commands in fuel/dispatch.py. Diese Liste ist außerdem NICHT identisch mit
# dispatch.py's STACK_CONTROL_WORDS (dort fehlen "prod", "cloud", "sync",
# "catalog", "v2" — relevant nur falls fuel.dispatch.main() direkt ohne
# diesen Entrypoint aufgerufen wird).
CONTROL_COMMANDS = {"status", "dev", "prod", "cloud", "sync", "catalog", "local", "v2"}


def _delegate_to_fuelctl() -> int:
    return subprocess.run([str(BIN_DIR / "fuelctl"), *sys.argv[1:]]).returncode

if __name__ == "__main__":
    try:
        if len(sys.argv) > 1 and sys.argv[1] in CONTROL_COMMANDS:
            raise SystemExit(_delegate_to_fuelctl())

        sys.path.insert(0, str(BIN_DIR.parent))
        from fuel.dispatch import main

        main()
    except KeyboardInterrupt:
        print("\nAbbruch.")
        sys.exit(130)
