#!/usr/bin/env python3
"""Thin entry point — Logik lebt in fuel/dispatch.py.

Existiert weiterhin als ausführbares Script (nicht nur als uv-Entry-Point),
weil AlphaOS-PATH-Konvention auf `<pillar>/bin/*` als Executables setzt statt
auf eine venv-Aktivierung. `fuel.dispatch` selbst hängt außerdem per
subprocess von diesem Pfad ab (ruft `bin/fuel-meal` / `bin/fuel-supplement`).
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from fuel.dispatch import main

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAbbruch.")
        sys.exit(130)
